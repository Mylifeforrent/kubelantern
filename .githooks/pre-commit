#!/usr/bin/env bash
# huntai-sre —— pre-commit 凭据泄漏门禁
# 由 `git config core.hooksPath .githooks` 启用（见 .zcode/scripts/setup-git-hooks.sh）。
# 这是人工提交与 AI 提交共用的最后一道防线；禁止用 --no-verify 绕过（项目安全红线）。
set -uo pipefail

root="$(git rev-parse --show-toplevel)" || exit 1
scanner="$root/.zcode/scripts/secret_scan.py"

python3_bin="$(command -v python3 || true)"
if [ -z "$python3_bin" ]; then
  echo "[secret-guard] 未找到 python3，无法执行凭据检查，提交被阻止。" >&2
  exit 1
fi
if [ ! -f "$scanner" ]; then
  echo "[secret-guard] 找不到扫描器 $scanner，提交被阻止。" >&2
  exit 1
fi

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0

fail=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  [ -f "$root/$f" ] || continue  # 已删除的文件不扫
  if ! "$python3_bin" "$scanner" path "$root/$f" --label "$f"; then
    fail=1
  fi
done <<< "$staged"

if [ "$fail" -ne 0 ]; then
  cat >&2 <<'EOF'
[secret-guard] 提交被阻止：暂存区存在疑似凭据或禁止入库的文件。
  - 真实凭据移入 .env（已 gitignore）或密钥管理服务；
  - 误报请改用占位符（your-api-key、sk-xxxx），规则调整由维护者人工修改 .zcode/scripts/secret_scan.py；
  - 禁止 git commit --no-verify 绕过本检查。
EOF
  exit 1
fi
exit 0
