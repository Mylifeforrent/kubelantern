# huntai-sre 本地环境变量模板
# 用法：cp .env.example .env 后填入真实值；.env 已被 .gitignore 排除，禁止提交。
# 本文件只允许占位符，禁止出现真实凭据（护栏会扫描并拦截）。
# 后端配置统一 HUNTAI_ 前缀（docs/03-tech-design/04-backend-design.md §6.3）。

# --- 服务基础 ---
HUNTAI_ENV=dev
HUNTAI_API_HOST=127.0.0.1
HUNTAI_API_PORT=8000
HUNTAI_LOG_LEVEL=info
HUNTAI_LOG_FORMAT=json

# --- 存储（compose 默认端口；本机直连时保持此值） ---
HUNTAI_DATABASE_URL=postgresql+asyncpg://huntai:your-password@127.0.0.1:5433/huntai
HUNTAI_DATABASE_POOL_SIZE=10
HUNTAI_DATABASE_MAX_OVERFLOW=20
HUNTAI_REDIS_URL=redis://127.0.0.1:6380/0

# --- dev 占位认证（[TBD-INFRA]，正式认证方式定稿后替换 core/security.py 实现） ---
HUNTAI_AUTH_SECRET=your-auth-secret
HUNTAI_AUTH_TOKEN_TTL_MINUTES=720
HUNTAI_DEV_AUTH_PASSWORD=your-dev-password

# --- 密钥后端（dev 仅支持 env:VAR 引用；生产 [TBD-INFRA]） ---
HUNTAI_SECRET_BACKEND=env
# 掩码加密密钥：32 字节 base64；生成：python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
HUNTAI_MASK_ENCRYPTION_KEY_REF=env:HUNTAI_MASK_KEY
HUNTAI_MASK_KEY=your-base64-32byte-key

# --- 演示集群只读凭证（seed 的 demo-cluster-readonly 引用此变量） ---
# 必须是只读 ServiceAccount token（BR-02）；真实值只放本地 .env，禁止入库/入日志。
# 未配置时探活按 disconnected 降级，巡检快照失败会把 run 标记 failed（不阻塞页面）。
HUNTAI_DEMO_CLUSTER_TOKEN=your-cluster-token

# --- AI 网关（BR-03/BR-12；P1） ---
HUNTAI_AI_LOCAL_ENDPOINT=http://127.0.0.1:11434
HUNTAI_AI_LOCAL_MODEL=llama3.1
HUNTAI_AI_EGRESS_ENABLED=false
# 外部 OpenAI 兼容模型（DeepSeek/OpenAI）。默认关闭；密钥只放 .env 或集群 Secret。
HUNTAI_AI_EXTERNAL_URL=https://api.deepseek.com/v1
HUNTAI_AI_EXTERNAL_MODEL=deepseek-chat
HUNTAI_AI_EXTERNAL_KEY_REF=env:HUNTAI_AI_EXTERNAL_KEY
HUNTAI_AI_EXTERNAL_KEY=your-deepseek-api-key
HUNTAI_AI_BUDGET_DEFAULT_CALLS=40
HUNTAI_AI_BUDGET_DEFAULT_TOKENS=100000
HUNTAI_AI_CIRCUIT_FAILURES=5
HUNTAI_AI_CIRCUIT_RESET_SECONDS=60
HUNTAI_APPROVAL_TIMEOUT_MINUTES=30

# --- 管道 / 限流 / SSE（阈值均 [ASSUMPTION]，P0 压测校准） ---
HUNTAI_REPLAY_STALE_SECONDS=60
HUNTAI_REPLAY_SCAN_SECONDS=30
HUNTAI_RATE_LIMIT_WEBHOOK_CAPACITY=100
HUNTAI_RATE_LIMIT_WEBHOOK_RATE_PER_SECOND=10
HUNTAI_SSE_HEARTBEAT_SECONDS=15
HUNTAI_STREAM_RETENTION_MINUTES=30

# --- 前端构建相关（Vite 读取，非后端） ---
LOG_LEVEL=INFO
