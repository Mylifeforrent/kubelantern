# 前端环境变量白名单：仅 VITE_ 前缀（03-frontend-design §8.3）
# 禁止任何密钥进入 VITE_* 或前端代码——构建产物对用户完全可读。

# API 基址；默认同源（dev 经 Vite proxy 转发，见 vite.config.ts）
VITE_API_BASE_URL=/api/v1

# mock 开关：1 = 内置 mock 层（阶段一 S2，05-fe-be-boundary §3.1）；0/缺省 = 走真实 api
VITE_USE_MOCK=0

# dev proxy 目标（后端默认端口 8000；被占用时改成实际端口，如 8001）
VITE_PROXY_TARGET=http://127.0.0.1:8000
